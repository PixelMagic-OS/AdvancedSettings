<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/advancedsettings_lockscreen_title">

    <PreferenceCategory
        android:key="udfps_category"
        android:title="@string/advancedsettings_udfps_title">

        <Preference
            android:key="udfps_recognizing_animation_preview"
            android:icon="@drawable/ic_fp_selector"
            android:title="@string/udfps_recog_animation_effect_title"
            android:summary="@string/udfps_recog_animation_effect_summary"
            android:fragment="com.pm.settings.fragments.lockscreen.UdfpsAnimation" />

    </PreferenceCategory>
    
    <PreferenceCategory
        android:key="qs_lockscreen_category"
        android:title="@string/advancedsettings_qs_title">
    
        <com.android.settings.custom.preference.SystemSettingSwitchPreference
            android:key="secure_lockscreen_qs_disabled"
            android:title="@string/disable_qs_title"
            android:summary="@string/disable_qs_summary"
            android:defaultValue="false"/>

    </PreferenceCategory>

</PreferenceScreen>
